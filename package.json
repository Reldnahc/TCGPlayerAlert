{
  "name": "tcgplayer-alert",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first, configurable seller fulfillment automation service",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:web && npm run build:extension",
    "build:server": "tsup && node scripts/copy-background-assets.mjs",
    "build:web": "vite build",
    "build:extension": "node scripts/build-browser-extension.mjs",
    "preview:web": "npm run build && node scripts/preview-ui.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build:web",
    "test": "vitest run",
    "pretest:browser": "npm run build",
    "test:browser": "playwright test",
    "test:watch": "vitest",
    "audit": "npm audit --audit-level=high",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "start": "node --env-file=.env.local dist/cli.js start",
    "configure": "node --env-file=.env.local dist/cli.js configure",
    "sync": "node --env-file=.env.local dist/cli.js sync",
    "status": "node --env-file=.env.local dist/cli.js status",
    "config:validate": "node --env-file=.env.local dist/cli.js config validate"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.88",
    "node-av": "6.1.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "5.4.624",
    "preact": "10.29.8",
    "tcgplayer-private-api": "file:.packages/tcgplayer-private-api-0.16.0.tgz"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.4",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "20.19.39",
    "eslint": "10.8.0",
    "jsdom": "27.0.1",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "werift": {
      "@shinyoshiaki/binary-data": "npm:@seydx/binary-data@0.6.2",
      "ip": "npm:neoip@2.1.0"
    },
    "werift-dtls": {
      "@shinyoshiaki/binary-data": "npm:@seydx/binary-data@0.6.2"
    },
    "werift-ice": {
      "ip": "npm:neoip@2.1.0"
    },
    "werift-sctp": {
      "@shinyoshiaki/binary-data": "npm:@seydx/binary-data@0.6.2"
    }
  }
}
