{
  "manifest_version": 3,
  "name": "TCGPlayerAlert Session Connector",
  "version": "0.1.0",
  "description": "Pairs a signed-in TCGplayer seller session with the local TCGPlayerAlert application after an explicit click.",
  "homepage_url": "https://github.com/Reldnahc/TCGPlayerAlert",
  "incognito": "not_allowed",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": ["https://store.tcgplayer.com/*", "http://127.0.0.1/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Connect TCGPlayerAlert",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "session-connector@tcgplayeralert.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["authenticationInfo"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
