{
  "manifest_version": 3,
  "name": "TCGPlayerAlert Session Connector",
  "version": "0.1.0",
  "description": "Pairs a signed-in TCGplayer seller session with the local TCGPlayerAlert application after an explicit click.",
  "homepage_url": "https://github.com/Reldnahc/TCGPlayerAlert",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": ["https://store.tcgplayer.com/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Connect TCGPlayerAlert",
    "default_popup": "popup.html"
  }
}
